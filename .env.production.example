# Copy to .env.production on the server and fill in. Never commit the filled file.
# Ranked (Weave Mode) verifier: a 64-hex secret and its matching public key.
RANKED_VERIFIER_SECRET=
RANKED_VERIFIER_PUBLIC_KEY=
# Optional overrides; the build already points at the testnet contract.
RANKED_CONTRACT_ID=
NEAR_RPC_URL=
# Email sign-in (Privy). Add the server's address to the Privy app's allowed origins.
VITE_EVERFOLK_PRIVY_APP_ID=
# Testnet account that funds each new player's play key.
EVERFOLK_FUNDER_ACCOUNT_ID=
EVERFOLK_FUNDER_PRIVATE_KEY=
# Admin access to the content editor.
ADMIN_EMAILS=
# Optional live NPC provider; without it NPCs follow the game rules.
NPC_PROVIDER=
NPC_LAYA_ENDPOINT=
NPC_LAYA_KEY=
