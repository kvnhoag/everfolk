# setup-vps.sh writes runtime.env with these values and resolved image digests.
EVERFOLK_INSTALL_ROOT=/opt/everfolk-art
EVERFOLK_DATA_ROOT=/srv/everfolk-art
ORIGIN_PORT=8788
ORIGIN_CPUS=1.0
ORIGIN_MEMORY=256m
TUNNEL_CPUS=0.5
TUNNEL_MEMORY=256m
ORIGIN_RPS=100
ORIGIN_BURST=200
ORIGIN_CONNECTIONS=128
TUNNEL_ENABLED=0
# The setup script pulls these tags once, then records repository@sha256 digests.
NGINX_SOURCE_IMAGE=nginx:stable-alpine
CLOUDFLARED_SOURCE_IMAGE=cloudflare/cloudflared:latest
