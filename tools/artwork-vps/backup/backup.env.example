# Copy to /etc/everfolk-art/backup.env; owner root, mode 0600.
# This must identify storage outside the artwork VPS.
RESTIC_REPOSITORY=sftp:backup@backup.example.net:/srv/backups/everfolk-art
RESTIC_PASSWORD_FILE=/etc/everfolk-art/restic-password
# Use a dedicated root-owned SSH config and pinned known_hosts for the backup host.
# RESTIC_SFTP_COMMAND='ssh -F /etc/everfolk-art/ssh_config backup-host -s sftp'
ART_DATA_ROOT=/srv/everfolk-art
