{
  "name": "historical-lives-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Setting-independent life simulation engine; historical content to follow.",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "demo": "node examples/play.ts",
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
